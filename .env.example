OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Current generateContent model. Invalid/retired ids return HTTP 404, not 503.
# HTTP 503 from Gemini is Google UNAVAILABLE (capacity), not a missing key.
GEMINI_MODEL=gemini-3.6-flash

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
